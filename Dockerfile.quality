# syntax=docker/dockerfile:1.27.1@sha256:4edf897a3ffa55b89f906fc8cc78afdb3f1834cc9c7083565e611a8a7d5fe99e
FROM node:24.22.0-bookworm-slim@sha256:a5f4366e834695d5f363b920c104953a535d3a9864d1bdf74566a0ebe01daee5 AS quality
RUN apt-get update && apt-get install -y --no-install-recommends make git && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json ./
RUN --mount=type=cache,id=rules-npm-node24-linux-amd64,target=/root/.npm,sharing=locked npm ci --ignore-scripts
ENV CONTAINERIZED=1 npm_config_cache=/tmp/npm
COPY --chmod=u=rwX,go=rX . ./
CMD ["make", "check"]
