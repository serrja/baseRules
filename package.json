{
  "name": "base-rules-docs",
  "private": true,
  "license": "MIT",
  "engines": { "node": "24.x" },
  "scripts": {
    "check": "npm run check:markdown && npm run check:links && npm run check:templates",
    "check:markdown": "markdownlint-cli2 \"**/*.md\" \"#node_modules\"",
    "check:links": "find . -path ./node_modules -prune -o -name '*.md' -type f -print0 | xargs -0 -r -n1 markdown-link-check --config .markdown-link-check.json --quiet",
    "check:templates": "node scripts/check-templates.mjs && node --test scripts/check-templates.test.mjs"
  },
  "devDependencies": {
    "markdown-link-check": "3.15.0",
    "markdownlint-cli2": "0.23.3"
  }
}
